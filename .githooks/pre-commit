#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.asdf/shims:$HOME/.mise/shims:$HOME/.local/bin:/usr/local/bin:$PATH"

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

STAGED_EX_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs)$' || true)"
if [[ -n "${STAGED_EX_FILES}" ]]; then
  printf '%s\n' "${STAGED_EX_FILES}" | xargs mix format --check-formatted
  printf '%s\n' "${STAGED_EX_FILES}" | xargs mix credo --min-priority high
fi

./scripts/gitleaks-pre-commit.sh
