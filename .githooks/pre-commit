#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "error: gitleaks is not installed or not on PATH." >&2
  echo "Install with: brew install gitleaks" >&2
  echo "Then re-run your commit." >&2
  exit 1
fi

exec gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
