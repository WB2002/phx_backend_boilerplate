#!/bin/sh

# Require runtime RELEASE_COOKIE for security (prevent fallback to baked-in cookie)
if [ -z "$RELEASE_COOKIE" ]; then
  echo "Error: RELEASE_COOKIE environment variable must be set" >&2
  exit 1
fi

# Configure distribution. Default to none unless DNS clustering is configured.
if [ -z "$DNS_CLUSTER_QUERY" ]; then
  export RELEASE_DISTRIBUTION=none
else
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="<%= @release.name %>@${POD_IP:-$(hostname -i 2>/dev/null || hostname)}"
fi
