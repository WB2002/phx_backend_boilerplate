# Local verify only (compile/test via scripts/verify.sh when host mix is missing).
# syntax=docker/dockerfile:1
FROM elixir:1.20-otp-27-slim@sha256:4b347e1107b4530c1722afbbcd7d908995557ec9188f2fe362c04d407ddcdd63

# hadolint ignore=DL3008
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends build-essential git ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -d /home/appuser appuser

USER 10001:10001

WORKDIR /app
ENTRYPOINT ["mix"]
