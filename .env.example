# Example environment variables for local development.
# Copy to `.env` and adjust. Do not commit real secrets.

# CORS — comma-separated exact origins (never "*")
# Dev defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# reCAPTCHA v3 (Google)
# Dev defaults RECAPTCHA_SKIP=true so curl demos work without a key.
# RECAPTCHA_SKIP=false
# RECAPTCHA_SECRET_KEY=your-google-recaptcha-v3-secret
# RECAPTCHA_MIN_SCORE=0.5

# Stripe Checkout
# Dev defaults STRIPE_SKIP=true so local API works without keys.
# STRIPE_SKIP=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_LIFETIME=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# Production database TLS (when not using sslmode=require in DATABASE_URL)
# DATABASE_SSL=true

# Trust X-Forwarded-For for rate limiting / reCAPTCHA when behind a reverse proxy
# TRUST_X_FORWARDED_FOR=true
# Dev only — skip scanning when ClamAV is unavailable locally (e.g. arm64).
# Boot fails in production and other Mix envs if CLAMAV_SKIP is set.
# CLAMAV_SKIP=true
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
