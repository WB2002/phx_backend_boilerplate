# Conformance audit runtime configuration defaults (non-secret placeholders).
# Secrets (SECRET_KEY_BASE, ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET) are
# generated ephemerally by scripts/ci/run-conformance-audit.sh when unset.

MIX_ENV=prod
PHX_SERVER=true
PHX_HOST=127.0.0.1
PORT=4000
DATABASE_URL=ecto://postgres:postgres@127.0.0.1:5432/phx_backend_boilerplate_conformance
REDIS_URL=redis://127.0.0.1:6379/2
POOL_SIZE=10
STRIPE_SKIP=true
RECAPTCHA_SECRET_KEY=conformance-recaptcha-placeholder
CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_METRICS_ENABLED=false
OTEL_TRACES_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
